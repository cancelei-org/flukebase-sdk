{
  "name": "@flukebase/client",
  "version": "0.1.1",
  "description": "Thin server-side client for the FlukeBase platform — email, Lightning payments, and MCP tools/call. One tested place for auth, retries, webhook verification, and secret redaction so tenants stop reimplementing (and re-bugging) the client.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "flukebase",
    "email",
    "lightning",
    "payments",
    "mcp",
    "sdk",
    "client"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cancelei-org/flukebase-sdk.git"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
